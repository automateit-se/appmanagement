# Settings for deploy/compose.yml. Copy to .env next to compose.yml and fill in.
# .env stays on the server: it is never committed.

# IoT Open users who may set up, stop and remove edge clients: e-mail or user id, comma separated (required)
EDGE_ADMINS=

# Image tag of App Management: a release (recommended) or main (the latest build of the main branch)
APPMANAGEMENT_TAG=0.1.0

# Optional
# GITHUB_TOKEN=            # raises GitHub's rate limit; a token without scopes is enough
# GITHUB_OWNERS=automateit-se
# GITHUB_INCLUDE=IoTOpen/edge-app-*
# LYNX_URL=https://lynx.iotopen.se
# ALLOWED_LYNX_HOSTS=lynx.iotopen.se
# APP_TITLE=App Management
# EDGE_CLIENT_IMAGE=ghcr.io/iotopen/edge-client:latest
