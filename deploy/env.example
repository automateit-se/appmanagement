# Settings for deploy/compose.yml. Copy to .env next to compose.yml and fill in.
# .env stays on the server: it is never committed.

# Image tag of App Management: a release (recommended) or main (the latest build of the main branch)
APPMANAGEMENT_TAG=0.1.9

# Optional
# Who may do what is decided by the user's role in IoT Open (e.g. admin and owner may manage edge clients).
# Setting up a new edge client starts a new container on this server, and the server can restrict that further.
# Looking at, starting, stopping, updating and removing edge clients still follows the IoT Open role.
# EDGE_PERMISSION: only users whose IoT Open role also has this permission may set up new edge clients here,
# e.g. a permission that only a dedicated role has. Wildcards in the role (external/example/*) count.
# EDGE_PERMISSION=
# EDGE_ADMINS: only these IoT Open users may set up new edge clients here. Comma-separated e-mail addresses,
# user ids or e-mail domains, e.g. EDGE_ADMINS=@example.com
# EDGE_ADMINS=
# EDGE_PORT_RANGE: host ports an app in an edge client may be published on (the local dashboard's 8090, for
# example), set per edge client on its page. Empty = no publishing. EDGE_PORT_BIND: the address they listen on
# (default 0.0.0.0 = every network of the host). The apps answer on plain http: keep them on a trusted network.
# EDGE_PORT_RANGE=18000-18099
# EDGE_PORT_BIND=0.0.0.0
# GITHUB_TOKEN=            # raises GitHub's rate limit; a token without scopes is enough
# GITHUB_OWNERS=automateit-se
# GITHUB_INCLUDE=IoTOpen/edge-app-*
# LYNX_URL=https://lynx.iotopen.se
# ALLOWED_LYNX_HOSTS=lynx.iotopen.se
# APP_TITLE=App Management
# EDGE_CLIENT_IMAGE=ghcr.io/iotopen/edge-client:latest
