{
  "name": "appmanagement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manage IoT Open Edge Apps: install apps from GitHub on installations, configure and update them, and run an IoT Open Docker Edge Client.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock/server.mjs",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
